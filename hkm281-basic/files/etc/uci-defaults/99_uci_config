! grep -q "kucat" /etc/config/luci || uci -q set luci.main.mediaurlbase='/luci-static/kucat'
uci -q commit luci

# Fibocom Modem interface
if grep -q "8087 ProdID=095a" /sys/kernel/debug/usb/devices ; then
    uci -q batch <<-EOF >/dev/null
	delete network.mm
	set network.wan1.device='wwan0'
	
	set network.xmm=interface
	set network.xmm.proto='xmm'
	set network.xmm.device='/dev/ttyACM0'
	set network.xmm.apn='internet'
	set network.xmm.auth='auto'
	set network.xmm.pdp='ipv4v6'
	add_list network.xmm.dns='8.8.8.8'
	add_list network.xmm.dns='8.8.4.4'
	commit network
	
	add_list firewall.@zone[1].network='xmm'
	commit firewall
	EOF

    if [ -f "/etc/config/3ginfo" ]; then
        uci -q batch <<-EOF >/dev/null
	set 3ginfo.@3ginfo[0].network='@xmm'
	commit 3ginfo
	EOF
    fi
    
elif grep -qE "FM350-GL|0e8d ProdID=2000|0e8d ProdID=7101|0e8d ProdID=7126|0e8d ProdID=7127" /sys/kernel/debug/usb/devices ; then
    ATC_DEVICE='/dev/ttyUSB1'
    
    if grep -q "0e8d ProdID=7126" /sys/kernel/debug/usb/devices ; then
        ATC_DEVICE='/dev/ttyUSB1'
    fi
    
    uci -q batch <<-EOF >/dev/null
	delete network.mm
	set network.wan1.device='wwan0'
	
	set network.atc=interface
	set network.atc.proto='atc'
	set network.atc.device='$ATC_DEVICE'
	set network.atc.apn='internet'
	set network.atc.auth='0'
	set network.atc.pdp='IP'
	set network.atc.atc_debug='0'
	add_list network.atc.dns='8.8.8.8'
	add_list network.atc.dns='8.8.4.4'
	commit network
	
	add_list firewall.@zone[1].network='atc'
	commit firewall
	EOF
    
    if [ -f "/etc/config/3ginfo" ]; then
        uci -q batch <<-EOF >/dev/null
	set 3ginfo.@3ginfo[0].network='@atc'
	commit 3ginfo
	EOF
    fi
    
fi

# Overview credit
DIS=$(grep "PRETTY_NAME" /usr/lib/os-release | awk -F '"' '{print $2}')
sed -i "s/.*OPENWRT_RELEASE.*/OPENWRT_RELEASE=\"$DIS IMBAPACK-2K26\"/" /usr/lib/os-release
sed -i "s/\/ ':'')+(luciversion||'')/ ':'')/" /www/luci-static/resources/view/status/include/10_system.js


# Configure WLAN
sleep 3

