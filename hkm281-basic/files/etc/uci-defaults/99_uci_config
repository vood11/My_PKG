# Install IPK packages from /root/ipk/
if [ -d "/root/ipk" ] && [ -n "$(ls /root/ipk/*.ipk 2>/dev/null)" ]; then
    cd /root/ipk
    opkg install *.ipk --force-reinstall
    rm -rf /root/ipk/*.ipk
    logger "All IPK packages installed successfully"
fi

# Auto rename Broadcom firmware files for Orange Pi CM4
BRCM_DIR="/lib/firmware/brcm"
if [ -d "$BRCM_DIR" ]; then
    for file in "$BRCM_DIR"/brcmfmac43456-sdio.*; do
        if [ -f "$file" ]; then
            filename=$(basename "$file")
            # Extract extension after brcmfmac43456-sdio
            extension="${filename#brcmfmac43456-sdio}"
            newname="brcmfmac43456-sdio.rockchip,rk3566-orangepi-cm4${extension}"
            
            # Only rename if new file doesn't exist
            if [ ! -f "$BRCM_DIR/$newname" ]; then
                cp "$file" "$BRCM_DIR/$newname"
                logger "Copied firmware: $filename -> $newname"
            fi
        fi
    done
fi

uci -q batch <<-EOF >/dev/null
  # System properties
  set system.@system[0].hostname="IMBA"
  set system.@system[0].conloglevel="8"
  set system.@system[0].cronloglevel="9"

  # Timezone
  set system.@system[0].zonename='Asia/Jakarta'
  set system.@system[0].timezone='WIB-7'

  # NTP servers
  del system.ntp.server
  add_list system.ntp.server="0.id.pool.ntp.org"
  add_list system.ntp.server="ntp.bmkg.go.id"
  add_list system.ntp.server="time.google.com"
  add_list system.ntp.server="0.sg.pool.ntp.org"
  add_list system.ntp.server="0.pool.ntp.org"

  # Luci language & Theme
  set luci.main.lang="en"

  #Add interface & firewall MM
  set network.mm=interface
  set network.mm.proto='modemmanager'
  set network.mm.device="$(readlink -f /sys/class/usbmisc/cdc-wdm0/device | sed "s|/$(readlink -f /sys/class/usbmisc/cdc-wdm0/device/ | awk -F '/' '{print $(NF)}')||g")"
  set network.mm.apn='internet'
  set network.mm.auth='none'
  set network.mm.iptype='ipv4'
  set network.mm.signalrate='10'
  set network.mm.force_connection='1'

  if ! grep -q "eth1" /etc/config/network; then
    set network.wan1=interface
    set network.wan1.proto='dhcp'
    set network.wan1.device='eth1'
  else
    set network.wan1=interface
    set network.wan1.proto='dhcp'
    set network.wan1.device='eth2'
  fi
  
  set network.wan2=interface
  set network.wan2.proto='dhcp'
  set network.wan2.device='usb0'

  set firewall.@zone[1].network="$(uci -q get firewall.@zone[1].network) wan1 wan2 mm"

  # SMS Tool JS
  set sms_tool_js.@sms_tool_js[0].ledtimeon='1'
  set sms_tool_js.@sms_tool_js[0].ledtimeoff='5'
  set sms_tool_js.@sms_tool_js[0].lednotify='0'
  set sms_tool_js.@sms_tool_js[0].checktime='10'
  set sms_tool_js.@sms_tool_js[0].pdu='0'
  set sms_tool_js.@sms_tool_js[0].storage='SM'
  set sms_tool_js.@sms_tool_js[0].prestart='6'
  set sms_tool_js.@sms_tool_js[0].ledtype='D'
  set sms_tool_js.@sms_tool_js[0].readport='/dev/ttyUSB1'
  set sms_tool_js.@sms_tool_js[0].sendport='/dev/ttyUSB1'
  set sms_tool_js.@sms_tool_js[0].pnumber='63'
  set sms_tool_js.@sms_tool_js[0].prefix='0'
  set sms_tool_js.@sms_tool_js[0].information='0'
  set sms_tool_js.@sms_tool_js[0].ussdport='/dev/ttyUSB1'
  set sms_tool_js.@sms_tool_js[0].atport='/dev/ttyUSB1'
  set sms_tool_js.@sms_tool_js[0].smsled='red:status'
  set sms_tool_js.@sms_tool_js[0].storage='ME'
  set sms_tool_js.@sms_tool_js[0].mergesms='0'
  set sms_tool_js.@sms_tool_js[0].algorithm='Simple'
  set sms_tool_js.@sms_tool_js[0].ussd='1'

  # Watchdog
  set watchdog.@watchdog[0]='watchdog'
  set watchdog.@watchdog[0].log='all'
  set watchdog.@watchdog[0].delay='600'
  set watchdog.@watchdog[0].iface='wwan'
  set watchdog.@watchdog[0].modemrestart='0'
  set watchdog.@watchdog[0].ledstatus='0'
  set watchdog.@watchdog[0].dest='112.215.37.182'
  set watchdog.@watchdog[0].period='2'
  set watchdog.@watchdog[0].period_count='3'
  set watchdog.@watchdog[0].enabled='1'
  set watchdog.@watchdog[0].action='wan'

  # Modemband
  set modemband.@modemband[0]='modemband'
  set modemband.@modemband[0].iface='mm'
  set modemband.@modemband[0].set_port='/dev/ttyUSB1'
  set modemband.@modemband[0].wanrestart='0'
  set modemband.@modemband[0].modemrestart='0'
  set modemband.@modemband[0].notify='0'

  # 3ginfo
  set 3ginfo.@3ginfo[0]='3ginfo'
  set 3ginfo.@3ginfo[0].network='mm'
  set 3ginfo.@3ginfo[0].device='/dev/ttyUSB1'

  # IRQBalance
  set irqbalance.irqbalance=irqbalance
  set irqbalance.irqbalance.enabled='1'
  set irqbalance.irqbalance.deepestcache='2'
  set irqbalance.irqbalance.interval='10'

  # Internet Detector
  set internet-detector.config.mode='0'

  # Custom Commands (target /etc/config/luci)
  set luci.cek_bb='command'
  set luci.cek_bb.name='RESTART MODEM'
  set luci.cek_bb.command='atcmd AT+CFUN=1,1'

  set luci.remove_lock='command'
  set luci.remove_lock.name='Cek QOS Fibocom L8x0'
  set luci.remove_lock.command='atcmd AT+CGEQNEG'

  set luci.set_lock='command'
  set luci.set_lock.name='Cek FTM Lock DW5821e'
  set luci.set_lock.command='atcmd at+ftm?'

  set luci.lock_b1_b3='command'
  set luci.lock_b1_b3.name='Cek FCC Lock L850-GL'
  set luci.lock_b1_b3.command='atcmd at@nvm:fix_cat_fcclock.fcclock_mode?'

  set luci.lock_b1_b3='command'
  set luci.lock_b1_b3.name='Restart ModemManager'
  set luci.lock_b1_b3.command='mmcli -m any -r'

  # Firewall for VPN Zone
  add firewall zone
  set firewall.@zone[-1].name='vpn'
  set firewall.@zone[-1].input='ACCEPT'
  set firewall.@zone[-1].output='ACCEPT'
  set firewall.@zone[-1].forward='ACCEPT'
  set firewall.@zone[-1].masq='1'
  add_list firewall.@zone[-1].network='openvpn'

  # Allow VPN to access LAN
  add firewall forwarding
  set firewall.@forwarding[-1].src='vpn'
  set firewall.@forwarding[-1].dest='lan'

  # Apply all UCI changes
  commit system
  commit ntp
  commit network
  commit firewall
  commit sms_tool_js
  commit watchdog
  commit modemband
  commit 3ginfo
  commit irqbalance
  commit internet-detector
  commit luci_commands
EOF

# Set Luci Theme
