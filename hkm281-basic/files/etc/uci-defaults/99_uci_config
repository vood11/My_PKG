  uci -q set ttyd.@ttyd[0].interface='@lan'
  uci -q set ttyd.@ttyd[0].command='/bin/login -f root'
  uci -q commit ttyd
  logger "helmilog : Terminal ttyd patched..."
  echo -e "helmilog : Terminal ttyd patched..."
fi

# Set 3ginfo-lite
if [ -f "/etc/config/3ginfo" ]; then
	[ ! -f "/usr/share/3ginfo-lite/modem/usb/0e8d7126" ] && cp /usr/share/3ginfo-lite/modem/usb/2cb70104 /usr/share/3ginfo-lite/modem/usb/0e8d7126
	[ ! -f "/usr/share/3ginfo-lite/modem/usb/1b7c1910" ] && cp /usr/share/3ginfo-lite/modem/usb/413c81d7 /usr/share/3ginfo-lite/modem/usb/1b7c1910
	[ ! -f "/usr/share/3ginfo-lite/modem/usb/1bc71911" ] && cp /usr/share/3ginfo-lite/modem/usb/413c81d7 /usr/share/3ginfo-lite/modem/usb/1bc71911 
	[ ! -f "/usr/share/3ginfo-lite/modem/usb/413c81e0" ] && cp /usr/share/3ginfo-lite/modem/usb/413c81d7 /usr/share/3ginfo-lite/modem/usb/413c81e0
	[ ! -f "/usr/share/3ginfo-lite/modem/usb/413c81e4" ] && cp /usr/share/3ginfo-lite/modem/usb/413c81d7 /usr/share/3ginfo-lite/modem/usb/413c81e4

	uci -q set 3ginfo.@3ginfo[0].network='@mm'
	uci -q set 3ginfo.@3ginfo[0].device='/dev/ttyUSB1'
	uci -q commit 3ginfo
fi
# Fix Temp
if [ -f "/usr/libexec/rpcd/luci.temp-status" ]; then
	INCLUDE="/www/luci-static/resources/view/status/include"
	mv $INCLUDE/*temp.js $INCLUDE/11_temp.js
fi

# TTL 65
cat << 'EOF' > /etc/nftables.d/11-ttl.nft
chain mangle_postrouting_ttl65 {
      type filter hook postrouting priority 300; policy accept;
 	counter ip ttl set 65 
}

chain mangle_prerouting_ttl65 {
      type filter hook prerouting priority 300; policy accept;
 	counter ip ttl set 65 
}
EOF

# Set Netdata
if opkg list-installed | grep netdata > /dev/null; then
	uci -q set netdata.@netdata[0].enabled='1'
	uci -q commit nedata
fi

# Set Vnstat2
if opkg list-installed | grep luci-app-vnstat2 > /dev/null; then
	uci -q set vnstat.@vnstat[0].interface='br-lan'
	uci -q add_list vnstat.@vnstat[0].interface='wwan0'
	uci -q add_list vnstat.@vnstat[0].interface='eth1'
	uci -q commit vnstat
		
BRD=$(cat /etc/os-release | grep -i 'OPENWRT_BOARD'| awk -F '"' '{print $2}' | awk -F '/' '{print $1}')
	if ! [ "$BRD" = "mediatek" ] || [ "$BRD" = "ipq40xx" ]; then
	    mkdir -p /etc/vnstat
	    sed -i 's/;DatabaseDir "\/var\/lib\/vnstat"/DatabaseDir "\/etc\/vnstat"/' /etc/vnstat.conf
	fi
	/etc/init.d/vnstat start
fi

# Move 25-modemmanager-tty
if [ -f "/etc/hotplug.d/tty/25-modemmanager-tty" ]; then
	mkdir -p /etc/bak
    mv /etc/hotplug.d/tty/25-modemmanager-tty /etc/bak/25-modemmanager-tty
	#restore
	#mv /etc/bak/25-modemmanager-tty /etc/hotplug.d/tty/25-modemmanager-tty
	/etc/init.d/modemmanager stop
    /etc/init.d/modemmanager start
fi

/etc/init.d/modemmanager restart
/etc/init.d/modemmanager reload

# Fix Temp Modeminfo (only if installed)
if opkg list-installed | grep -q "luci-app-modeminfo"; then
	if [ -f "/usr/share/modeminfo/scripts/DELL.at" ]; then
		sed -i "s|AT+TEMP?; AT^TEMP?|AT^TEMP?; AT+TEMP?|" /usr/share/modeminfo/scripts/DELL.at
	fi
fi

# Move tiny file manager (only if installed)
if opkg list-installed | grep -q "luci-app-tinyfilemanager"; then
	if [ -f "/usr/share/luci/menu.d/luci-app-tinyfilemanager.json" ]; then
		sed -i -e '/"admin\/nas": {/,+7d' /usr/share/luci/menu.d/luci-app-tinyfilemanager.json
		sed -i 's|/nas/|/system/|g' /usr/share/luci/menu.d/luci-app-tinyfilemanager.json
		uci -q add_list tinyfilemanager.@main[0].auth_users='root:$2y$10$TLasyNswvi/Y1v7tz8C8N.a6LKnM4gMDn70A9w76nWICzVoaS0B1G'
		uci set tinyfilemanager.cfg017f6a.use_auth='0'
	    uci -q commit tinyfilemanager
	    /etc/init.d/tinyfilemanager restart
	fi
fi

# Fix Openclash (only if installed)
if opkg list-installed | grep -q "luci-app-openclash"; then
	sed -i "s|option ifname 'utun'|option device 'utun'|" /etc/config/network

	#STATUS="/usr/lib/lua/luci/view/openclash/status.htm"
	DEV="/usr/lib/lua/luci/view/openclash/developer.htm"
	MYIP="/usr/lib/lua/luci/view/openclash/myip.htm"
	#IMG="/luci-static/resources/openclash/img"
	CLIENT="/usr/lib/lua/luci/model/cbi/openclash/client.lua"
	CONT="/usr/lib/lua/luci/controller/openclash.lua"

	if ! grep -qE "\-\- s:section|\-\-s:section" $CLIENT
	then
		sed -i "s#s:section#-- s:section#g" $CLIENT
		mv $MYIP $MYIP.bak
		cat << 'EOF' > $MYIP
<!DOCTYPE html>
<html>
</html>
EOF
	fi

	if grep -q 'githubusercontent.com' $DEV
	then
		sed -i 's#translate("Credits")#translate("")#g' $CLIENT
		mv $DEV $DEV.bak
		cat << 'EOF' > $DEV
