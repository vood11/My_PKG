if [ -z "$HOSTNAME" ]; then
    HOSTNAME="OpenWrt"
fi

RADIO_5G=""
RADIO_2G=""

for section in $(uci show wireless | grep '=wifi-device' | cut -d'.' -f2 | cut -d'=' -f1); do
    
    path=$(uci -q get wireless."$section".path)
    
    if echo "$path" | grep -q 'pcie'; then
        RADIO_5G="$section"
        
    elif echo "$path" | grep -q 'mmc'; then
        RADIO_2G="$section"
    fi
done

if [ -n "$RADIO_5G" ]; then
    uci set wireless."$RADIO_5G".band='5g'
    uci set wireless."$RADIO_5G".channel='36'
    uci set wireless."$RADIO_5G".cell_density='0'
    uci set wireless."$RADIO_5G".disabled='0' 
    uci set wireless.default_"$RADIO_5G".ssid="${HOSTNAME}-AX"
    uci set wireless.default_"$RADIO_5G".encryption='psk2'
    uci set wireless.default_"$RADIO_5G".key='dbai2k26'
fi

if [ -n "$RADIO_2G" ]; then
    uci set wireless."$RADIO_2G".band='2g'
    uci set wireless."$RADIO_2G".htmode='HT20'
    uci set wireless."$RADIO_2G".channel='6'
    uci set wireless."$RADIO_2G".country='CN'
    uci set wireless."$RADIO_2G".cell_density='0'
    uci set wireless."$RADIO_2G".disabled='0'
    uci set wireless.default_"$RADIO_2G".ssid="${HOSTNAME}-AC"
    uci set wireless.default_"$RADIO_2G".encryption='psk2'
    uci set wireless.default_"$RADIO_2G".key='dbai2k26'
fi

uci -q commit wireless

# KONFIGURASI TTYD TANPA LOGIN
